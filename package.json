{
  "name": "open-software-suite",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "desktop/main.cjs",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/copy-pdfjs-resources.mjs && vite apps/opendraft --host 127.0.0.1",
    "build": "node scripts/copy-pdfjs-resources.mjs && tsc --noEmit && vite build apps/opendraft",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "audit:licenses": "node scripts/licenses.mjs",
    "desktop:runtime": "node node_modules/electron/install.js",
    "desktop:package": "npm run build && electron-builder --config desktop/electron-builder.yml --win --x64"
  },
  "dependencies": {
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "asn1js": "3.0.6",
    "fflate": "0.8.3",
    "jsfeat": "0.0.8",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pkijs": "3.4.3",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "write-excel-file": "4.1.1"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
